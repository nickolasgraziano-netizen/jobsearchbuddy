# ── Supabase ──────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Search config ─────────────────────────────────────────────────────
HOME_ZIP=80524
SEARCH_RADIUS_MILES=25

# ── Free API keys (see README for signup links) ───────────────────────
# CareerOneStop — best free source for hourly/warehouse. careeronestop.org/Developers
COS_API_KEY=
COS_USER_ID=

# JSearch — the legitimate Indeed/LinkedIn/ZipRecruiter/Glassdoor route.
# rapidapi.com → search "JSearch" → subscribe to the free tier
RAPIDAPI_KEY=

# USAJOBS — federal. developer.usajobs.gov
USAJOBS_API_KEY=
USAJOBS_EMAIL=

# Adzuna — broad aggregation + salary estimates. developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Optional extras
JOOBLE_KEY=
CAREERJET_AFFID=
FINDWORK_KEY=

# ── Cron protection ───────────────────────────────────────────────────
CRON_SECRET=change-me-to-a-long-random-string

# ── LLM scoring (stage 2) ────────────────────────────────────────────
# console.anthropic.com — a key dedicated to this project. ~$1-3/month.
ANTHROPIC_API_KEY=

# ── /hub Basic Auth (middleware.js) ─────────────────────────────────────
# Gates /hub once deployed. Unset = no gate (fine for local dev only).
BASIC_AUTH_USER=
BASIC_AUTH_PASS=
